<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: the existing dark Material theme, plus a matching style for every pop-up dialog
         (confirmations, choices, prompts), so none of them fall back to Android's plain grey box. -->
    <style name="BlockBrowser" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#83B9FF</item>
        <item name="android:alertDialogTheme">@style/BlockBrowser.Dialog</item>
        <item name="android:popupMenuStyle">@android:style/Widget.Material.PopupMenu</item>
    </style>

    <style name="BlockBrowser.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorBackground">#1B2638</item>
        <item name="android:colorAccent">#83B9FF</item>
        <item name="android:textColorPrimary">#EAF1FC</item>
        <item name="android:textColorSecondary">#AAB8CC</item>
        <item name="android:textColorAlertDialogListItem">#EAF1FC</item>
        <item name="android:colorControlNormal">#AAB8CC</item>
        <item name="android:colorControlActivated">#83B9FF</item>
        <item name="android:buttonBarButtonStyle">@style/BlockBrowser.DialogButton</item>
        <item name="android:windowTitleStyle">@style/BlockBrowser.DialogTitle</item>
    </style>

    <style name="BlockBrowser.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#83B9FF</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="BlockBrowser.DialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">#EAF1FC</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
