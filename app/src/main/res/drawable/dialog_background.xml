<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark card for pop-up dialogs, inset from the screen edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="#1B2638" />
        <corners android:radius="24dp" />
        <stroke android:width="1dp" android:color="#26324A" />
    </shape>
</inset>
